#!/bin/sh
set -eu

branch=$(git symbolic-ref --quiet --short HEAD) || {
  echo "Commit blocked: detached HEAD. Switch to the task branch before committing." >&2
  exit 1
}

if [ "$branch" = main ]; then
  echo "Commit blocked: main is protected. Create or switch to a codex/<task-name> branch." >&2
  exit 1
fi
